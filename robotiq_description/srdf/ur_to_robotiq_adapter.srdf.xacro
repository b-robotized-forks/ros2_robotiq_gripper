<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="ur_to_robotiq_srdf" params="prefix parent child">

    <disable_collisions link1="${parent}" link2="${prefix}ur_to_robotiq_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}ur_to_robotiq_link" link2="${child}" reason="Adjacent"/>

  </xacro:macro>
</robot>
